{
  "transform": {
    "^.+\\.tsx?$": ["babel-jest", { "configFile": "./babel.config.js" }]
  },
  "testRegex": "(tests|src)/.*\\.test\\.(ts|tsx)$",
  "moduleFileExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json",
    "node"
  ],
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts"
  ],
  "testEnvironment": "node"
}